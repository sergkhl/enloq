{
  "name": "enloq-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check src/*.tsx src/*.ts src/*.css journeys live *.ts index.html",
    "journeys": "playwright test -c playwright.journeys.config.ts",
    "live": "playwright test -c playwright.live.config.ts"
  },
  "dependencies": {
    "lottie-web": "5.13.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "openapi-typescript": "^7.9.0",
    "prettier": "3.9.9",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
