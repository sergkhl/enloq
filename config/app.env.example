# Prepared private references only. Copy under umask 077; never commit populated files.
# Mode/port are selected by the service or dev command. Model and cache bounds
# are fixed in application code, and the Daily Budget and Concurrency Limit are
# set in Settings; this file overrides none of them.
ENLOQ_LISTEN_HOST=127.0.0.1
ENLOQ_TIMEZONE=Asia/Ho_Chi_Minh
ENLOQ_PERSONAL_TELEGRAM_API_ID_REF=
ENLOQ_PERSONAL_TELEGRAM_API_HASH_REF=
# The owner's LiteLLM proxy (https://llm.globesoul.com/v1) and its caller key.
ENLOQ_MUSE_ENDPOINT_REF=
ENLOQ_MUSE_API_KEY_REF=
# Legacy first-account registration only. New accounts use the in-app login.
ENLOQ_PERSONAL_SESSION_REF=
ENLOQ_EXPECTED_ACCOUNT_ID=

# Android push through Firebase Cloud Messaging (ADR 38): the Firebase project, its sending service account, the uploaded
# key's ID and the private key file generated beside it. Leave all four empty
# where phones get no push.
ENLOQ_FCM_PROJECT=
ENLOQ_FCM_ACCOUNT=
ENLOQ_FCM_KEY_ID=
ENLOQ_FCM_KEY_REF=

# Web Push keys/subscriptions are generated locally, never pasted here.
# <app data>/push-vapid.pem and accounts.sqlite3 stay private and ignored.
