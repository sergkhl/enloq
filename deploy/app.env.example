# The VPS service's config/app.env (ADR 40). ./scripts/deploy installs it once;
# the owner places the secrets with setup inside the container (see operations).
ENLOQ_LISTEN_HOST=0.0.0.0
ENLOQ_PUBLIC_ORIGIN=https://enloq.globesoul.com
ENLOQ_TRUSTED_PROXY=lrnki-caddy
ENLOQ_TIMEZONE=Asia/Ho_Chi_Minh
# Android push (ADR 38); the key pair is generated in
# secrets/ on this host and only its certificate is uploaded (see operations).
ENLOQ_FCM_PROJECT=enloq-globesoul
ENLOQ_FCM_ACCOUNT=enloq-push@enloq-globesoul.iam.gserviceaccount.com
ENLOQ_FCM_KEY_ID=c173c7922357abcdd6eb3c672cd63433ceb45e21
ENLOQ_FCM_KEY_REF=secrets/fcm-key.pem
# Saved Builds and Telegram pairing codes (ADR 43 Q4, Q8) go to this signed-in
# account's own Saved Messages: its Telegram user ID.
# ENLOQ_OWNER_ACCOUNT=
